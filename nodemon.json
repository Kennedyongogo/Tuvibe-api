{
  "watch": ["src"],
  "ext": "js,json",
  "ignore": [
    "node_modules",
    "uploads/**/*",
    "public/**/*",
    ".git",
    "*.log",
    "*.md",
    "*.txt",
    "*.traineddata",
    "Dockerfile",
    ".dockerignore",
    ".gitignore"
  ],
  "delay": 1000,
  "verbose": true,
  "env": {
    "NODE_ENV": "development"
  }
}

